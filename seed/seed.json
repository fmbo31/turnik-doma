    "plan": {
     "A": [
      {
       "exId": "hang",
       "name": "Вис на турнике",
       "sets": 3,
       "target": 20,
       "unit": "sec",
       "perSide": false,
       "how": "«Плечи опущены» = отвести плечи от ушей, как будто кладёте лопатки в задние карманы. Руки прямые, тело не болтается. Хват: большой палец обхватывает перекладину снизу («в замок»). Пальцы разжимаются — это нормально в начале: висите сколько держат, добирайте время частями."
      },
      {
       "exId": "neg",
       "name": "Негативные подтягивания",
       "sets": 3,
       "target": 3,
       "unit": "reps",
       "perSide": false,
       "how": "Спуск 4–5 сек, подниматься прыжком/со скамьи"
      },
      {
       "exId": "pushup",
       "name": "Отжимания от пола",
       "sets": 3,
       "target": 12,
       "unit": "reps",
       "perSide": false,
       "how": "Спина прямая, локти под 45°"
      },
      {
       "exId": "bridge",
       "name": "Ягодичный мостик",
       "sets": 2,
       "target": 15,
       "unit": "reps",
       "perSide": false,
       "how": "Лёжа на спине, стопы у таза. Поднять таз до прямой линии колени–плечи, наверху сжать ягодицы 2 сек. Колени не болят — если болят, отметить"
      },
      {
       "exId": "side_plank",
       "name": "Боковая планка",
       "sets": 2,
       "target": 40,
       "unit": "sec",
       "perSide": true,
       "how": "Бёдра вверху; начинать с левой (слабее)"
      }
     ],
     "B": [
      {
       "exId": "hang",
       "name": "Вис на турнике",
       "sets": 2,
       "target": 20,
       "unit": "sec",
       "perSide": false,
       "how": "«Плечи опущены» = отвести плечи от ушей, как будто кладёте лопатки в задние карманы. Руки прямые, тело не болтается."
      },
      {
       "exId": "aus",
       "name": "Австралийские подтягивания",
       "sets": 3,
       "target": 6,
       "unit": "reps",
       "perSide": false,
       "how": "Перекладина на уровне пояса, пятки на полу, тело прямое как доска. Тянуть грудь к перекладине, локти назад к рёбрам, наверху пауза 1 сек и свести лопатки, вниз 2 сек. Чем ниже перекладина/дальше ноги — тем тяжелее.",
       "extra": "пауза наверху"
      },
      {
       "exId": "bench_dip",
       "name": "Отжимания от скамьи",
       "sets": 3,
       "target": 15,
       "unit": "reps",
       "perSide": false,
       "how": "Корпус ровный, локти вдоль тела. Стало ещё легко — ноги поставить на стул"
      },
      {
       "exId": "wall_sit",
       "name": "Стульчик у стены",
       "sets": 3,
       "target": 20,
       "unit": "sec",
       "perSide": false,
       "how": "Спина на стене, бёдра ВЫШЕ параллели (неглубоко), колени над пятками. Стоять, а не двигаться. Боль в колене — сразу выйти и отметить"
      },
      {
       "exId": "leg_raise",
       "name": "Подъём ног лёжа (согнутые)",
       "sets": 2,
       "target": 12,
       "unit": "reps",
       "perSide": false,
       "how": "Лёжа на спине, руки вдоль тела, колени согнуты под 90°. Поясница прижата к полу всё время (подложите ладонь — она не должна освобождаться). Поднимать колени к груди, таз чуть отрывается; вниз медленно, 2–3 сек, стопы пола не касаются."
      },
      {
       "exId": "plank",
       "name": "Планка",
       "sets": 2,
       "target": 45,
       "unit": "sec",
       "perSide": false,
       "how": "Прямая линия от головы до пят, живот и ягодицы напряжены"
      }
     ]
    }
